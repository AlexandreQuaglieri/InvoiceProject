# ──────────────────────────────────────────────────────────────────────────────
# Factur-IA — variables d'environnement
# Copier en .env.local pour le dev, ou définir sur votre plateforme (Vercel…).
# REQUIS = l'app ne fonctionne pas (ou pas complètement) sans.
# OPTIONNEL = la fonctionnalité associée se désactive proprement si absent.
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase (REQUIS) ─────────────────────────────────────────────────────────
# Créez un projet sur https://supabase.com puis Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon
# Clé service_role — serveur uniquement, ne JAMAIS l'exposer côté client.
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role

# ── URL publique de l'app (REQUIS en production) ──────────────────────────────
# Source de vérité du flux OAuth et du connecteur MCP. Sans elle : localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── IA (REQUIS pour l'assistant, l'extraction de documents et la recherche) ───
# https://console.anthropic.com — les utilisateurs peuvent aussi fournir leur
# propre clé dans les réglages (BYOK), chiffrée avec APP_ENCRYPTION_KEY.
ANTHROPIC_API_KEY=sk-ant-...

# ── Chiffrement des secrets utilisateurs (REQUIS dès qu'un utilisateur
#    enregistre une clé API ou des identifiants Chorus Pro) ────────────────────
# Générer avec : openssl rand -base64 32. ⚠️ La changer invalide les secrets déjà
# chiffrés (les utilisateurs devront les ressaisir).
APP_ENCRYPTION_KEY=

# ── Cron (REQUIS pour la synchro PDP planifiée) ───────────────────────────────
# Générer avec : openssl rand -hex 32. Vercel l'envoie automatiquement en
# Authorization: Bearer sur /api/cron/pdp-sync. Sans elle, le cron répond 401.
CRON_SECRET=

# ── Auth (OPTIONNEL) ──────────────────────────────────────────────────────────
# Providers OAuth affichés sur l'écran de connexion (à activer aussi dans
# Supabase Auth). Ex : google,azure,discord
NEXT_PUBLIC_AUTH_PROVIDERS=google

# ── PDP / facturation électronique (OPTIONNEL — désactivé proprement si absent)
# Identifiants OAuth de votre plateforme agréée partenaire.
SUPER_PDP_CLIENT_ID=
SUPER_PDP_CLIENT_SECRET=
SUPER_PDP_SANDBOX=true

# ── Chorus Pro / PISTE, secteur public (OPTIONNEL) ────────────────────────────
CHORUS_PRO_CLIENT_ID=
CHORUS_PRO_CLIENT_SECRET=
CHORUS_PRO_LOGIN=
CHORUS_PRO_PASSWORD=
CHORUS_PRO_SANDBOX=true

# ── Hub de notifications (OPTIONNEL — aucun email/notification si absent) ─────
# Service de notifications externe (emails transactionnels, Discord).
NOTIFICATION_HUB_URL=
NOTIFICATION_API_KEY=
NOTIFICATION_SIGNING_SECRET=
NOTIFICATION_APP=
NOTIFICATION_ORG_ID=
NOTIFICATION_ADMIN_EMAIL=
NOTIFICATION_SUPPORT_EMAIL=

# ── Data Wallet / Fluid Store (OPTIONNEL — carte et synchro masquées si absent)
WALLET_URL=
WALLET_API_KEY=
NEXT_PUBLIC_WALLET_URL=
NEXT_PUBLIC_WALLET_APP_ID=

# ── Identité légale de l'éditeur (REQUIS pour un site public en France) ───────
# Injectée dans les pages mentions légales / CGU / confidentialité.
# Sans ces valeurs, les pages affichent des placeholders [à configurer : …].
LEGAL_OWNER=Prénom Nom
LEGAL_ADDRESS=1 rue de l'Exemple, 75001 Paris, France
LEGAL_EMAIL=contact@exemple.fr
LEGAL_SIREN=123 456 789
LEGAL_SIRET=123 456 789 00014
LEGAL_RCS=123 456 789 R.C.S. Paris
LEGAL_VAT=FR12123456789

# ── Divers (OPTIONNEL) ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPPORT_PHONE=
